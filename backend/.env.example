# ─────────────────────────────────────────────────────────────────────────────
# Assay backend secrets — copy this file to `backend/.env.local` and fill in real
# values. `backend/.env.local` is git-ignored; NEVER commit a real private key or
# paste it in chat. `npm run dev` loads this file; production uses host env vars.
# ─────────────────────────────────────────────────────────────────────────────

# Server
ASSAY_RUNTIME=development
PORT=4000
ASSAY_DB=data/assay.sqlite
CORS_ORIGIN=http://localhost:3000

# Production safety boundary. These public values configure the receipt-anchor
# verification path planned for the next stage; they are not wallet credentials.
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io

# Development-only switches. Production startup rejects either value when set to 1.
ASSAY_TEST_SETTLE=0
ASSAY_MOCK_PAY=0

# ── BUYER (the agent's paying wallet) ───────────────────────────────────────
# Funded Arc-testnet wallet that runs the real x402 → Gateway nanopayment flow.
# Fund it with testnet USDC before running with ASSAY_MOCK_PAY off.
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# How much USDC to deposit into the Gateway balance when it runs low (kept topped
# up so a batch of sub-cent buys never stalls mid-run).
DEPOSIT_AMOUNT=0.5
